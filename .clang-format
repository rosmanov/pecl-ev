BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: ForIndentation

# Alignment
AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false

# Formatting
ColumnLimit: 0 # Don't rewrap existing code
BreakBeforeBraces: Linux

# Preprocessor
IndentPPDirectives: None

# Includes
SortIncludes:
  Enabled: false
